nced:0.8410 F1:0.8889\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x500 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["bipmetrics.csv saved\n"]}]},{"cell_type":"code","source":["## STEP 6.5: MEJOR UMBRAL\n","# Find best threshold to maximize Balanced Accuracy\n","probs = results['probs']\n","labels = results['labels']\n","\n","best_thr = 0.5\n","best_bal = 0.0\n","for thr in np.linspace(0, 1, 101):  # Test 101 thresholds: 0.00, 0.01, ..., 1.00\n","    preds_thr = (probs >= thr).astype(int)\n","    bal = balanced_accuracy_score(labels, preds_thr)\n","    if bal > best_bal:\n","        best_bal = bal\n","        best_thr = thr\n","\n","print(f\"Best threshold: {best_thr:.2f}, Balanced Acc: {best_bal:.4f}\")\n","\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"MmxE1uq80OsF","executionInfo":{"status":"ok","timestamp":1768914263104,"user_tz":0,"elapsed":120,"user":{"displayName":"Sergio Lugo","userId":"06265056640185052849"}},"outputId":"6b666078-af5b-49d2-f418-a51119667155"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Best threshold: 0.63, Balanced Acc: 0.8552\n"]}]},{"cell_type":"code","source":["## STEP 7: SAVE\n","timestamp = datetime.now().strftime(\"%Y%m%d_%H%M\")  # 202601191836\n","# Update: Make filename more generic\n","torch.save(model.state_dict(), f'bip_model_competition_{timestamp}.pth')\n","print(f\"Competition model: bip_model_competition_{timestamp}.pth\")"],"metadata":{"id":"MUPQjl9YI8pE","executionInfo":{"status":"ok","timestamp":1768914266240,"user_tz":0,"elapsed":145,"user":{"displayName":"Sergio Lugo","userId":"06265056640185052849"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"37b008d9-682c-4e9f-cd67-e029ca7c03b3"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Competition model: bip_model_competition_20260120_1304.pth\n"]}]},{"cell_type":"code","source":["# STEP 8: GRADCAM PARA TODAS LAS IMÁGENES ✅ ResNet34\n","!pip install grad-cam -q\n","\n","import torch\n","import torch.nn as nn\n","from torch.utils.data import DataLoader\n","from torchvision import transforms, datasets\n","from torchvision.models import resnet34\n","from pytorch_grad_cam import GradCAM\n","from pytorch_grad_cam.utils.image import show_cam_on_image\n","from pytorch_grad_cam.utils.model_targets import ClassifierOutputTarget\n","from PIL import Image\n","import os\n","from tqdm import tqdm\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import warnings\n","warnings.filterwarnings(\"ignore\")\n","\n","device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","print(f\"🚀 GradCAM ResNet34 - Device: {device}\")\n","\n","# ================================\n","# 1. CARGAR TU MODELO RESNET34\n","# ================================\n","model = resnet34(weights=None)\n","\n","# Reemplazar capa final (como en training)\n","num_features = model.fc.in_features\n","model.fc = nn.Sequential(\n","    nn.Linear(num_features, 512),\n","    nn.ReLU(),\n","    nn.Dropout(0.5),\n","    nn.Linear(512, 2)\n",")\n","model.load_state_dict(torch.load('model.pth', map_location=device))\n","model.to(device)\n","model.eval()\n","\n","# ✅ HABILITAR GRADIENTES (necesario para GradCAM)\n","for param in model.parameters():\n","    param.requires_grad = True\n","\n","# ✅ TARGET LAYER ResNet34 (última capa convolucional)\n","target_layers = [model.layer4[-1]]  # Último bloque residual\n","cam = GradCAM(model=model, target_layers=target_layers)\n","\n","print(\"✅ Modelo ResNet34 cargado correctamente\")\n","\n","# ================================\n","# 2. DATASET COMPLETO (todas las imágenes)\n","# ================================\n","test_transform = transforms.Compose([\n","    transforms.Resize((224, 224)),\n","    transforms.ToTensor(),\n","    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])\n","])\n","\n","test_dataset = datasets.ImageFolder(test_dir, transform=test_transform)\n","test_loader = DataLoader(test_dataset, batch_size=1, shuffle=False)\n","classes = test_dataset.classes  # ['glaucoma', 'normal']\n","\n","print(f\"📁 Dataset: {len(test_dataset)} imágenes totales\")\n","\n","# ================================\n","# 3. CARPETAS ORGANIZADAS\n","# ================================\n","os.makedirs('gradcam_results/normal', exist_ok=True)\n","os.makedirs('gradcam_results/glaucoma', exist_ok=True)\n","os.makedirs('gradcam_results/summary', exist_ok=True)\n","\n","print(\"🔥 Generando GradCAM para TODAS las imágenes...\")\n","\n","# ================================\n","# 4. GENERAR GRADCAM PARA TODAS\n","# ================================\n","all_results = []\n","\n","for idx, (input_tensor, true_label) in enumerate(tqdm(test_loader, desc=\"GradCAM\")):\n","    input_tensor = input_tensor.to(device)\n","\n","    # Predicción\n","    with torch.no_grad():\n","        output = model(input_tensor)\n","        probs = torch.softmax(output, 1)[0].cpu().numpy()\n","        pred_label = np.argmax(probs)\n","        confidence = np.max(probs)\n","\n","    true_class = classes[true_label]\n","    pred_class = classes[pred_label]\n","\n","    # GradCAM para CLASE PREDICHA\n","    targets = [ClassifierOutputTarget(pred_label)]\n","    grayscale_cam = cam(input_tensor=input_tensor, targets=targets)[0, :]\n","\n","    # Denormalizar imagen original\n","    img = input_tensor[0].cpu().permute(1,2,0).numpy()\n","    img = img * np.array([0.229, 0.224, 0.225]) + np.array([0.485, 0.456, 0.406])\n","    img = np.clip(img, 0, 1)\n","\n","    # Overlay heatmap\n","    cam_overlay = show_cam_on_image(img, grayscale_cam, use_rgb=True)\n","\n","    # Guardar con nombre descriptivo\n","    filename = test_dataset.imgs[idx][0].split('/')[-1]\n","    correct = \"✓\" if pred_label == true_label else \"✗\"\n","    save_name = f\"{correct}_{true_class}_pred{pred_class}_conf{confidence:.2f}_{filename}\"\n","    save_dir = f'gradcam_results/{true_class}'\n","\n","    Image.fromarray((cam_overlay * 255).astype(np.uint8)).save(\n","        f'{save_dir}/{save_name}'\n","    )\n","\n","    all_results.append({\n","        'filename': filename,\n","        'true_class': true_class,\n","        'pred_class': pred_class,\n","        'confidence': confidence,\n","        'correct': pred_label == true_label\n","    })\n","\n","# ================================\n","# 5. RESUMEN ESTADÍSTICAS (CORREGIDO)\n","# ================================\n","# ✅ CONVERTIR Tensor a int/float\n","correct_count = sum([r['correct'] for r in all_results])  # int, no Tensor\n","total = len(all_results)\n","accuracy = correct_count / total  # float\n","\n","print(f\"\\n📊 RESULTADOS:\")\n","print(f\"   Total imágenes: {total}\")\n","print(f\"   Correctas: {correct_count} ({accuracy:.1%})\")  # ✅ Ahora funciona\n","print(f\"   Incorrectas: {total - correct_count}\")\n","\n","# Ejemplos visualización (6 imágenes)\n","fig, axes = plt.subplots(2, 3, figsize=(18, 12))\n","sample_indices = np.random.choice(len(all_results), min(6, len(all_results)), replace=False)\n","\n","for i, idx in enumerate(sample_indices):\n","    row, col = divmod(i, 3)\n","    result = all_results[idx]\n","\n","    # Cargar imagen guardada\n","    save_dir = f'gradcam_results/{result[\"true_class\"]}'\n","    files = [f for f in os.listdir(save_dir) if result['filename'] in f]\n","    if files:\n","        img_path = os.path.join(save_dir, files[0])\n","        img = plt.imread(img_path)\n","\n","        axes[row, col].imshow(img)\n","        axes[row, col].set_title(\n","            f\"True: {result['true_class']}\\nPred: {result['pred_class']}\\n\"\n","            f\"Conf: {result['confidence']:.1%} {'✓' if result['correct'] else '✗'}\"\n","        )\n","        axes[row, col].axis('off')\n","\n","plt.suptitle('GRAD-CAM EXAMPLES (Rojo=Región Importante)', fontsize=16)\n","plt.tight_layout()\n","plt.savefig('gradcam_results/summary/examples.png', dpi=300, bbox_inches='tight')\n","plt.show()\n","\n","print(\"\\n✅ COMPLETADO!\")\n","print(\"📁 Revisa carpetas:\")\n","print(\"   gradcam_results/normal/ → Imágenes normales\")\n","print(\"   gradcam_results/glaucoma/ → Imágenes glaucoma\")\n","print(\"   gradcam_results/summary/examples.png → Resumen visual\")\n","print(\"\\n💡 Nombres: ✓=correcto ✗=error | Rojo en heatmap = DONDE MIRA tu ResNet34\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":471},"id":"vX2KflgrrdPS","executionInfo":{"status":"error","timestamp":1768915125564,"user_tz":0,"elapsed":134745,"user":{"displayName":"Sergio Lugo","userId":"06265056640185052849"}},"outputId":"a99e1773-523b-4eda-dce1-3937aab46d12"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["🚀 GradCAM ResNet34 - Device: cpu\n","✅ Modelo ResNet34 cargado correctamente\n","📁 Dataset: 146 imágenes totales\n","🔥 Generando GradCAM para TODAS las imágenes...\n"]},{"output_type":"stream","name":"stderr","text":["GradCAM: 100%|██████████| 146/146 [02:03<00:00,  1.18it/s]"]},{"output_type":"stream","name":"stdout","text":["\n","📊 RESULTADOS:\n","   Total imágenes: 146\n"]},{"output_type":"stream","name":"stderr","text":["\n"]},{"output_type":"error","ename":"TypeError","evalue":"unsupported format string passed to Tensor.__format__","traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mTypeError\u001b[0m                                 Traceback (most recent call last)","\u001b[0;32m/tmp/ipython-input-1882336020.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m    130\u001b[0m \u001b[0mprint\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34mf\"\\n📊 RESULTADOS:\"\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    131\u001b[0m \u001b[0mprint\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34mf\"   Total imágenes: {total}\"\u001b[0m\u001b[0;34m)\u001b[0m\u0