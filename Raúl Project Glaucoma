ss /= len(train_loader)\n","\n","    # Validation phase (no gradients)\n","    model.eval()\n","    test_auc = evaluate_auc(model, test_loader, device)\n","    scheduler.step(test_auc)  # Adjust learning rate based on AUC\n","\n","    print(f\"Epoch {epoch+1:2d} Loss={train_loss:.4f} AUC={test_auc:.4f}\")\n","\n","    # Save best model based on validation AUC\n","    if test_auc > best_auc:\n","        best_auc = test_auc\n","        torch.save(model.state_dict(), 'model.pth')  # Competition filename!\n","        print(f\"model.pth saved! Best AUC={best_auc:.4f}\")\n","\n","print(f\"Final Best AUC: {best_auc:.4f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":547},"id":"e844Z2kZJA8c","executionInfo":{"status":"error","timestamp":1768914220557,"user_tz":0,"elapsed":411263,"user":{"displayName":"Sergio Lugo","userId":"06265056640185052849"}},"outputId":"b8c6debc-bbad-4324-cdf4-9ef8d8635e5e"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Class counts: [120 219]\n","Class weights: [0.00833333 0.00456621]\n","Training...\n","Epoch  1 Loss=0.6760 AUC=0.8678\n","model.pth saved! Best AUC=0.8678\n","Epoch  2 Loss=0.5598 AUC=0.8744\n","model.pth saved! Best AUC=0.8744\n","Epoch  3 Loss=0.5161 AUC=0.8891\n","model.pth saved! Best AUC=0.8891\n","Epoch  4 Loss=0.5051 AUC=0.9061\n","model.pth saved! Best AUC=0.9061\n"]},{"output_type":"error","ename":"KeyboardInterrupt","evalue":"","traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mKeyboardInterrupt\u001b[0m                         Traceback (most recent call last)","\u001b[0;32m/tmp/ipython-input-3332135297.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m     25\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     26\u001b[0m         \u001b[0moptimizer\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mzero_grad\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m     \u0